namespace papercup {
    /// Returns the version of `papercup-core` baked into this build.
    string version();

    /// Parse the JSON payload encoded in the desktop's QR code (or pasted
    /// manually). Validates the three required fields and returns them.
    [Throws=PairError]
    QrPayload parse_qr_payload(string text);
};

[Error]
enum ApiError {
    "Network",
    "Server",
    "Decode",
    "Unauthorized",
};

[Error]
enum PairError {
    "InvalidQr",
    "Network",
    "Server",
    "Decode",
};

dictionary Harness {
    string slug;
    string path;
    boolean has_state;
    string? harness_kind;
    i64? iteration;
    i64? last_active_ts;
    string? status;
};

dictionary QrPayload {
    string server;
    string pair_token;
    string workspace_id;
};

dictionary PairOutcome {
    string device_token;
    string device_id;
    string workspace_id;
    string desktop_host;
};

interface OperatorClient {
    constructor(string base_url, string? device_token);

    [Throws=ApiError, Async]
    sequence<Harness> list_harnesses();

    /// `POST /api/mobile/pair` — exchanges a one-time pair token for a
    /// long-lived device JWT. The client's `device_token` is ignored
    /// for this call.
    [Throws=PairError, Async]
    PairOutcome pair(string pair_token);
};
