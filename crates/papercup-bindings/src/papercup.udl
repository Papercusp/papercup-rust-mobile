namespace papercup {
    /// Returns the version of `papercup-core` baked into this build.
    string version();

    /// Parse the JSON payload encoded in the desktop's QR code (or pasted
    /// manually). Validates the three required fields and returns them.
    [Throws=PairError]
    QrPayload parse_qr_payload(string text);

    /// Generate a fresh X25519 keypair, base64-encoded for WireGuard.
    /// The phone retains `private_key_b64` (Keystore/Keychain) and
    /// submits `public_key_b64` to the desktop during pair.
    WgKeyPair generate_wg_keypair();

    /// Render a wg-quick INI from the device's stored private key plus
    /// the broker-assigned mesh config.
    string mesh_to_wg_quick(string private_key_b64, MeshConfig config);
};

[Error]
enum ApiError {
    "Network",
    "Server",
    "Decode",
    "Unauthorized",
};

[Error]
enum PairError {
    "InvalidQr",
    "Network",
    "Server",
    "Decode",
};

[Error]
enum SyncError {
    "Closed",
};

[Error]
enum VoiceError {
    "Connect",
    "Closed",
};

enum VoiceStatus {
    "Idle",
    "Connecting",
    "Listening",
    "Speaking",
    "Paused",
};

[Enum]
interface VoiceEvent {
    Connected();
    Speak(string text, string source, string? agent_id, string? format);
    Closed(u16 code, string reason);
};

interface VoiceClient {
    /// Open a WebSocket to `<base_url>/api/mobile/voice` with bearer
    /// subprotocol auth + auto-reconnect with exp backoff. Phone does
    /// STT + TTS locally; this client only carries protocol frames.
    constructor(string base_url, string device_token, string? wake_word);

    [Throws=VoiceError, Async]
    VoiceEvent next_event();

    [Async]
    void send_status(VoiceStatus status);

    [Async]
    void send_transcript(string text);

    [Async]
    void send_hello(string wake_word);

    void disconnect();
};

dictionary Harness {
    string slug;
    string path;
    boolean has_state;
    string? harness_kind;
    i64? iteration;
    i64? last_active_ts;
    string? status;
};

/// Per `/api/mobile/harnesses/:slug` (Stage 2.6 backend). camelCase
/// fields preserved on the wire; UDL convention is snake — translation
/// happens in core::types.
dictionary HarnessStatus {
    string slug;
    string path;
    i64 iteration;
    boolean alive;
    boolean escalated;
    boolean smoke_fail;
    i64 pending_checkpoints;
    i64 active_competitions;
    f64 mission_cost_usd;
    i64 mission_input_tokens;
    i64 mission_output_tokens;
    string? last_decision;
    /// status -> count, e.g. {"DONE":12,"IN_PROGRESS":3}.
    record<string, i64> counts;
    /// Rough total just for the header chip; computed from `counts`.
    i64 feature_count;
};

dictionary QrPayload {
    string server;
    string pair_token;
    string workspace_id;
};

dictionary PairOutcome {
    string device_token;
    string device_id;
    string workspace_id;
    string desktop_host;
    /// Defguard mesh config returned by the broker, when configured.
    /// Phase 6a: surfaced for display + persistence; Phase 6b will use
    /// it to bring up the actual WireGuard tunnel.
    MeshConfig? mesh;
};

dictionary MeshConfig {
    string peer_public_key;
    string peer_endpoint;
    sequence<string> allowed_ips;
    string assigned_ip;
    u32 mtu;
};

dictionary WgKeyPair {
    string private_key_b64;
    string public_key_b64;
};

dictionary PauseInfo {
    boolean paused;
    string? at;
    string? by;
};

dictionary Toast {
    i64 id;
    string level;
    string message;
    i64 created_at;
    string? description;
    string? harness_slug;
    string? action_href;
    string? action_label;
};

dictionary AuditEntry {
    string id;
    i64 ts;
    string actor;
    string action;
    string subject;
    /// Raw JSON for `details`, possibly the literal string `"null"`.
    string details_json;
};

dictionary Workspace {
    string id;
    string name;
    boolean current;
    i64? last_activity_at;
};

dictionary Device {
    string device_id;
    string workspace_id;
    string? device_label;
    string? last_seen;
    string? paired_at;
};

dictionary SyncEvent {
    string id;
    string name;
    /// Raw JSON for `args` (or the literal string `"null"`).
    string args_json;
};

/// Long-running SSE subscription to `/api/mobile/sync/sse`. Reconnects
/// internally; call `close()` when the host UI tears down.
interface SyncStream {
    /// Open the stream. The connection is established asynchronously
    /// in a background task; `next_event()` will yield the first event
    /// once the SSE handshake completes.
    constructor(string base_url, string device_token);

    [Throws=SyncError, Async]
    SyncEvent next_event();

    void disconnect();
};

interface OperatorClient {
    constructor(string base_url, string? device_token);

    [Throws=ApiError, Async]
    sequence<Harness> list_harnesses();

    [Throws=ApiError, Async]
    HarnessStatus get_harness_status(string slug);

    /// `POST /api/mobile/push/register`. `platform` is "fcm" (Android)
    /// or "apns" (iOS).
    [Throws=ApiError, Async]
    void register_push(string platform, string token);

    /// `POST /api/mobile/heartbeat` — bumps server-side last_seen.
    [Throws=ApiError, Async]
    void heartbeat();

    /// `GET /api/mobile/operator/pause` — current global pause state.
    [Throws=ApiError, Async]
    PauseInfo pause_get();

    /// Set or clear the global pause flag; returns the new value.
    [Throws=ApiError, Async]
    boolean pause_set(boolean paused);

    /// Voice lease (Stage 2.13). Phone always pre-empts on claim.
    [Throws=ApiError, Async]
    void voice_lease_claim();

    [Throws=ApiError, Async]
    void voice_lease_heartbeat();

    [Throws=ApiError, Async]
    void voice_lease_release();

    /// `GET /api/mobile/notifications/recent`.
    [Throws=ApiError, Async]
    sequence<Toast> recent_notifications();

    /// `GET /api/mobile/actions/recent`.
    [Throws=ApiError, Async]
    sequence<AuditEntry> recent_actions();

    /// `GET /api/mobile/workspaces`.
    [Throws=ApiError, Async]
    sequence<Workspace> list_workspaces();

    /// `GET /api/mobile/desktop/devices`.
    [Throws=ApiError, Async]
    sequence<Device> list_desktop_devices();

    /// `DELETE /api/mobile/desktop/devices/{id}`.
    [Throws=ApiError, Async]
    void revoke_device(string device_id);

    /// `POST /api/mobile/pair` — exchanges a one-time pair token for a
    /// long-lived device JWT. The client's `device_token` is ignored
    /// for this call. `wireguard_pubkey_b64` is optional but should be
    /// supplied by Phase 6+ clients so the broker can register the
    /// device's public key.
    [Throws=PairError, Async]
    PairOutcome pair(string pair_token, string? wireguard_pubkey_b64);
};
