namespace papercup {
    /// Returns the version of `papercup-core` baked into this build.
    string version();

    /// Parse the JSON payload encoded in the desktop's QR code (or pasted
    /// manually). Validates the three required fields and returns them.
    [Throws=PairError]
    QrPayload parse_qr_payload(string text);

    /// Build the voice WS URL from the API base URL plus the
    /// runtime-config-discovered port + path (the voice WS listens on
    /// its own port — default :3068 — NOT the API port). Call
    /// OperatorClient.runtime_config() first; when its voice_ws_port is
    /// null the voice WS is down — show "voice unavailable".
    string voice_ws_url(string base_url, u16 port, string path);

    /// Phase 4 — parse a voice WS Speak frame for an inline directive.
    /// Recognised prefixes: [NAVIGATE: <slug>], [PAUSE], [RESUME],
    /// [CLAIM_VOICE]. Anything else returns Speak { text } unchanged.
    Intent parse_intent(string text);
};

[Enum]
interface Intent {
    Navigate(string slug, string speak);
    Pause(string speak);
    Resume(string speak);
    ClaimVoice(string speak);
    Speak(string text);
};

/// In-memory query cache with change-detecting polling. The SSE
/// invalidation stream is retired (mobile-apps-revival D-001.1): the
/// host instantiates one Cache per paired session, registers the query
/// names its UI watches, subscribes a CacheSubscriber, and calls
/// start_polling — updates fire only when a payload actually changes
/// (push notifications cover interrupt latency, D-004).
[Enum]
interface CacheUpdate {
    /// Refresh succeeded; value_json is the new payload, generation
    /// bumps on each successful refresh.
    Updated(string name, string value_json, i64 generation);
    /// Refresh failed; previous value (if any) still served.
    Failed(string name, string error);
};

callback interface CacheSubscriber {
    void on_update(CacheUpdate update);
};

interface SyncCache {
    /// Build a cache scoped to the given OperatorClient. The cache
    /// uses the client to refetch. Caller wires register_query at
    /// startup for each query name the UI watches.
    constructor(OperatorClient client);

    /// Tell the cache about a query name; triggers a first fetch and
    /// enrolls the name in the polling loop.
    void register_query(string name);

    /// Force-refresh a registered name now (e.g. a push notification
    /// named a changed surface, or pull-to-refresh). No-op for
    /// unregistered names.
    [Async]
    void handle_invalidate(string name);

    /// Start polling every registered query at the given interval
    /// (clamped to >= 500ms). Subscribers are notified only on actual
    /// payload change. Idempotent; restart replaces the loop.
    void start_polling(u64 interval_ms);

    /// Stop the polling loop (e.g. when the app backgrounds).
    void stop_polling();

    /// Subscribe to all cache deltas. Subscribers persist until the
    /// SyncCache is dropped or the host explicitly drops it.
    void subscribe(CacheSubscriber subscriber);

    /// Read the latest value (raw JSON) for a name, or null if never
    /// fetched.
    string? get(string name);
};

[Error]
interface ApiError {
    Network(string detail);
    Server(u16 status, string detail);
    Decode(string detail);
    Unauthorized();
};

[Error]
interface PairError {
    InvalidQr(string detail);
    Network(string detail);
    Server(u16 status, string detail);
    Decode(string detail);
    Unauthorized(string detail);
};

[Error]
enum VoiceError {
    "Connect",
    "Closed",
};

enum VoiceStatus {
    "Idle",
    "Connecting",
    "Listening",
    "Speaking",
    "Paused",
};

[Enum]
interface VoiceEvent {
    Connected();
    Speak(string text, string source, string? agent_id, string? format);
    Closed(u16 code, string reason);
};

interface VoiceClient {
    /// Open the voice WebSocket with bearer subprotocol auth +
    /// auto-reconnect with exp backoff. `ws_url` is the FULL WS URL —
    /// build it with voice_ws_url() from runtime_config()'s port + path
    /// (the WS listens on its own port, default :3068, NOT the API
    /// port). Phone does STT + TTS locally; this client only carries
    /// protocol frames.
    constructor(string ws_url, string device_token, string? wake_word);

    [Throws=VoiceError, Async]
    VoiceEvent next_event();

    [Async]
    void send_status(VoiceStatus status);

    [Async]
    void send_transcript(string text);

    [Async]
    void send_hello(string wake_word);

    void disconnect();
};

dictionary Harness {
    string slug;
    string path;
    boolean has_state;
    string? harness_kind;
    i64? iteration;
    i64? last_active_ts;
    string? status;
};

/// Per `/api/device/harnesses/:slug` (Stage 2.6 backend). camelCase
/// fields preserved on the wire; UDL convention is snake — translation
/// happens in core::types.
dictionary HarnessStatus {
    string slug;
    string path;
    i64 iteration;
    boolean alive;
    boolean escalated;
    boolean smoke_fail;
    i64 pending_checkpoints;
    i64 active_competitions;
    f64 mission_cost_usd;
    i64 mission_input_tokens;
    i64 mission_output_tokens;
    string? last_decision;
    /// status -> count, e.g. {"DONE":12,"IN_PROGRESS":3}.
    record<string, i64> counts;
    /// Rough total just for the header chip; computed from `counts`.
    i64 feature_count;
};

dictionary QrPayload {
    string server;
    string pair_token;
    string workspace_id;
};

dictionary PairOutcome {
    string device_token;
    string device_id;
    string workspace_id;
    string desktop_host;
    /// Defguard self-enrollment URL (D-005) — open/hand off at pair
    /// time so the device joins the mesh. Null when the server has no
    /// Defguard configured (LAN/public-tunnel reachability still works).
    string? defguard_enrollment_url;
};

/// `GET /api/device/runtime-config` — post-pair device config. The
/// voice WS port is the load-bearing field: null means the server's
/// voice WS failed to bind → show "voice unavailable" instead of
/// dialing a dead port.
dictionary RuntimeConfig {
    string mesh_host;
    string workspace_id;
    string device_kind;
    u16? voice_ws_port;
    string voice_ws_path;
};

/// `GET /api/device/voice-session-init` — ElevenLabs Conv AI session
/// bootstrap (the conversational voice flow). dynamic_variables_json is
/// forwarded to the EL SDK verbatim.
dictionary VoiceSessionInit {
    string conversation_token;
    string agent_id;
    double idle_timeout_min;
    double session_max_min;
    string voice_mode;
    string dynamic_variables_json;
};

dictionary PauseInfo {
    boolean paused;
    string? at;
    string? by;
};

dictionary VoiceLease {
    string workspace_id;
    string owner_id;
    /// "desktop" | "mobile"
    string owner_kind;
    i64 expires_at_ms;
};

dictionary Running {
    string harness_slug;
    string phase;
    string status;
    i32 iteration;
    i32 total_features;
    i32 passed_count;
    i32 todo_count;
    i32 blocked_count;
    sequence<string> active_roles;
    i64? last_active_ts;
};

dictionary RunningScan {
    i64 id;
    i64 started_at;
    string? request_text;
    f64 cost_usd;
};

dictionary RunningSnapshot {
    RunningScan? scan;
    sequence<Running> harnesses;
};

dictionary Toast {
    i64 id;
    string level;
    string message;
    i64 created_at;
    string? description;
    string? harness_slug;
    string? action_href;
    string? action_label;
};

dictionary AuditEntry {
    string id;
    i64 ts;
    string actor;
    string action;
    string subject;
    /// Raw JSON for `details`, possibly the literal string `"null"`.
    string details_json;
};

dictionary Workspace {
    string id;
    string name;
    boolean current;
    i64? last_activity_at;
};

dictionary WorkspaceSwitchResult {
    string device_token;
    string workspace_id;
};

dictionary Device {
    string device_id;
    string workspace_id;
    string? device_label;
    string? last_seen;
    string? paired_at;
};

/// The Inbox attention feed (D-002). groups_json is the opaque
/// attention-group payload; work_items is the decoded actionable layer.
dictionary AttentionFeed {
    string groups_json;
    sequence<AttentionWorkItem> work_items;
    i64 group_count;
    i64 work_item_count;
};

dictionary AttentionWorkItem {
    string id;
    string kind;
    string family;
    string? harness;
    string title;
    string summary;
    string state;
    string? assignee;
    string? assigned_by;
    string? severity;
    string? parent;
    string created_at;
    string updated_at;
};

/// One plan card. item_counts is status -> count.
dictionary PlanSummary {
    string slug;
    string harness;
    string title;
    string? status;
    string? updated;
    string? owner;
    boolean archived;
    record<string, i64> item_counts;
    string? now_state;
    string? now_next;
};

/// One plan's full detail. The parser-shaped sections are JSON strings.
dictionary PlanDetail {
    string slug;
    string harness;
    boolean archived;
    string title;
    string? status;
    string? owner;
    string frontmatter_json;
    string now_json;
    string items_json;
    string decisions_json;
};

dictionary StandingCandidate {
    string capability;
    string target_harness;
    i64 count;
    string last_seen_at;
    string? first_shown_at;
};

interface OperatorClient {
    constructor(string base_url, string? device_token);

    /// Phase 6c — preferred mesh URL with auto-fallback to public.
    /// Transport-level errors against `primary` swap to `fallback`
    /// for the rest of the session. HTTP 4xx/5xx do not trigger
    /// the swap (those propagate as ApiError::Server).
    [Name=new_with_fallback]
    constructor(string primary, string fallback, string? device_token);

    /// Phase 8 — register or clear the platform biometric prompt.
    /// When set, `revoke_device` (High) and `workspace_switch`
    /// (Medium) gate behind the prompt. Pass null to disable.
    void set_biometric_prompt(BiometricPrompt? prompt);

    [Throws=ApiError, Async]
    sequence<Harness> list_harnesses();

    [Throws=ApiError, Async]
    HarnessStatus get_harness_status(string slug);

    /// `POST /api/device/push/register`. `platform` is "fcm" (Android)
    /// or "apns" (iOS).
    [Throws=ApiError, Async]
    void register_push(string platform, string token);

    /// `POST /api/device/heartbeat` — bumps server-side last_seen.
    [Throws=ApiError, Async]
    void heartbeat();

    /// `GET /api/device/operator/pause` — current global pause state.
    [Throws=ApiError, Async]
    PauseInfo pause_get();

    /// Set or clear the global pause flag; returns the new value.
    [Throws=ApiError, Async]
    boolean pause_set(boolean paused);

    /// Voice lease (Stage 2.13). Phone always pre-empts on claim.
    [Throws=ApiError, Async]
    void voice_lease_claim();

    [Throws=ApiError, Async]
    void voice_lease_heartbeat();

    [Throws=ApiError, Async]
    void voice_lease_release();

    /// Returns the current lease holder, or null if nobody.
    [Throws=ApiError, Async]
    VoiceLease? voice_lease_get();

    /// `GET /api/device/running` — currently-running phases per harness.
    [Throws=ApiError, Async]
    sequence<Running> list_running();

    /// `GET /api/device/running` — full running snapshot including
    /// the current operator scan summary when one is active.
    [Throws=ApiError, Async]
    RunningSnapshot running_snapshot();

    /// `GET /api/device/notifications/recent`.
    [Throws=ApiError, Async]
    sequence<Toast> recent_notifications();

    /// `GET /api/device/actions/recent`.
    [Throws=ApiError, Async]
    sequence<AuditEntry> recent_actions();

    /// `GET /api/device/workspaces`.
    [Throws=ApiError, Async]
    sequence<Workspace> list_workspaces();

    /// `POST /api/device/workspace/switch` — issues a new deviceToken
    /// scoped to the target workspace.
    [Throws=ApiError, Async]
    WorkspaceSwitchResult workspace_switch(string workspace_id);

    /// `GET /api/device/devices`.
    [Throws=ApiError, Async]
    sequence<Device> list_desktop_devices();

    /// `DELETE /api/device/devices/{id}`.
    [Throws=ApiError, Async]
    void revoke_device(string device_id);

    /// `GET /api/device/runtime-config` — post-pair device config
    /// (voice WS port/path discovery).
    [Throws=ApiError, Async]
    RuntimeConfig runtime_config();

    /// `GET /api/device/voice-session-init` — mint an ElevenLabs Conv
    /// AI session token. Cooldown/concurrency rejections raise
    /// ApiError.Server with the server's hint in detail.
    [Throws=ApiError, Async]
    VoiceSessionInit voice_session_init();

    /// `GET /api/device/rest-query?name=&args=` — one-shot polling
    /// fetch; returns the rows payload as a JSON string. Prefer
    /// SyncCache + start_polling for UI surfaces.
    [Throws=ApiError, Async]
    string rest_query(string name, string args_json);

    /// `GET /api/device/attention` — the Inbox attention feed (D-002):
    /// canonical attention groups + the work_items-native actionable layer.
    [Throws=ApiError, Async]
    AttentionFeed attention();

    /// `GET /api/device/plans` — plan summaries. harness=null → All Pots.
    [Throws=ApiError, Async]
    sequence<PlanSummary> plans_list(string? harness, boolean include_archived);

    /// `GET /api/device/plans/:slug` — one plan's full detail.
    [Throws=ApiError, Async]
    PlanDetail plan_get(string slug, string? harness);

    /// `POST /api/device/plans/:slug/items/:itemId/status` — flip a plan
    /// item's status (approve→done, nudge→wip, gate→needs-human). Returns
    /// the server's result JSON as a string.
    [Throws=ApiError, Async]
    string plan_item_set_status(string slug, string item_id, string status, string? note, string? harness);

    /// `GET /api/device/operator/standing-candidates`.
    [Throws=ApiError, Async]
    sequence<StandingCandidate> standing_candidates();

    /// `POST /api/device/operator/standing-candidates/decide`.
    /// `approve = true` → "approve", false → "dismiss".
    [Throws=ApiError, Async]
    void standing_candidate_decide(string capability, string target_harness, boolean approve);

    /// `POST /api/device/pair` — exchanges a one-time pair token for a
    /// long-lived device JWT. The client's `device_token` is ignored
    /// for this call. The outcome's defguard_enrollment_url is the
    /// Defguard self-enrollment hand-off (no WG config at pair time).
    [Throws=PairError, Async]
    PairOutcome pair(string pair_token);
};

/// Phase 8 — biometric gating.
///
/// `BiometricPrompt` is a callback interface implemented by the
/// platform shell (Android: BiometricPrompt; iOS: LAContext). Rust
/// core decides which actions need a check (revoke_device → High,
/// workspace_switch → Medium) and calls `prompt(reason)` before the
/// action proceeds. The platform shows the OS-native prompt and
/// resolves synchronously with the user's decision.
[Enum]
interface BiometricResult {
    Approved();
    Denied();
    /// User cancelled or the platform isn't available (no enrolled
    /// fingerprint/face, hardware missing, etc.). Core treats as
    /// denied for high-risk actions; medium-risk falls through.
    Unavailable(string reason);
};

callback interface BiometricPrompt {
    BiometricResult prompt(string reason);
};
