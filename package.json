{
  "name": "papercup-rust-mobile-tooling",
  "private": true,
  "version": "0.0.0",
  "description": "Dev-only tooling for papercup-rust-mobile. Currently used for design-token codegen via Style Dictionary.",
  "scripts": {
    "tokens": "node design-tokens/mirror.mjs && style-dictionary build --config design-tokens/style-dictionary.config.mjs",
    "tokens:check": "node design-tokens/tokens-check.mjs"
  },
  "devDependencies": {
    "@papercusp/token-kit": "file:libs/token-kit",
    "style-dictionary": "^4.4.0"
  }
}
