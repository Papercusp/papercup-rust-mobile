    <string name="push_channel_name">Papercup updates</string>
    <string name="push_channel_description">Push notifications from your paired desktop.</string>

    <!-- Common error messages -->
    <string name="error_pair_token_expired">Pair code expired — generate a new one from the desktop.</string>
    <string name="error_mesh_unreachable">Mesh tunnel unreachable — falling back to public URL.</string>
    <string name="error_voice_ws_failed">Voice connection lost. Tap to reconnect.</string>
    <string name="error_push_permission_denied">Notifications disabled. Enable in Android Settings to get push alerts.</string>
