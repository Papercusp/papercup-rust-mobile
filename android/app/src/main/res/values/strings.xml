<?xml version="1.0" encoding="utf-8"?>
<!--
    Phase 10 — localization scaffold. Strings used by the Compose UI
    are resolved from here when wrapped in stringResource(R.string.X).
    English-only at launch; other locales drop into values-<lang>/.

    The bulk of the UI today still uses literal Kotlin strings; this
    file is the authoritative location for newly-added user-facing
    text and the migration target for the existing inline strings.
-->
<resources>
    <string name="app_name">Papercup</string>

    <!-- Tab nav (MainActivity bottom bar) -->
    <string name="tab_operator">Operator</string>
    <string name="tab_harnesses">Harnesses</string>
    <string name="tab_activity">Activity</string>
    <string name="tab_settings">Settings</string>

    <!-- Settings nav rows -->
    <string name="settings_standing_approvals">Standing approvals</string>
    <string name="settings_standing_approvals_subtitle">Auto-dispatched patterns waiting for review</string>
    <string name="settings_voice">Voice</string>
    <string name="settings_voice_subtitle">Wake word, speech rate, voices</string>
    <string name="settings_diagnostics">Diagnostics</string>
    <string name="settings_diagnostics_subtitle">Connection, mesh, build info</string>
    <string name="settings_forget_device">Forget this device</string>

    <!-- Connection banner -->
    <string name="connection_lost">Lost desktop connection</string>

    <!-- Wake-word service notification -->
    <string name="wake_word_notification_title">Papercup</string>
    <string name="wake_word_notification_text">Listening for "hey papercup"</string>
    <string name="wake_word_channel_name">Wake-word listener</string>
