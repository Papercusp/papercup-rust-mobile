<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Firebase Analytics is retained only for controlled non-public validation.
         Keep inherited advertising/attribution permissions out of public artifacts;
         Play Data Safety keys on declared permissions even when collection is off. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />
    <uses-permission
        android:name="com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE"
        tools:node="remove" />
    <!-- Phase 2: QR scanning for the pair flow. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Foreground service base perm (the wake-word mic FGS needs it). The mesh
         is now Defguard self-enrollment (system VPN) — no in-app VpnService. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Phase 5 fix: WakeWordService captures mic via Picovoice Porcupine.
         Per Play Store policy + Android 14+ runtime check, mic-recording
         services need foregroundServiceType="microphone" and this perm. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Phase 9: voice WS + STT (SpeechRecognizer requires RECORD_AUDIO). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <queries>
        <!-- SpeechRecognizer.isRecognitionAvailable() needs to see the
             system speech-recognition service in queries on Android 11+. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
    <!-- Phase 4+: RECORD_AUDIO, etc. -->

    <application
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Papercup.Starting"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <!-- Privacy (WI-5325): Papercup is a companion to the user's OWN desktop —
             no behavioral tracking. Firebase Analytics collection is DISABLED here.
             Crashlytics (crash diagnostics) + FCM (push) remain and are declared in
             the App Store / Play data-safety forms. -->
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_ssaid_collection_enabled" android:value="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|locale|smallestScreenSize|screenLayout|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
