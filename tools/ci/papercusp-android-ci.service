[Unit]
Description=Papercusp Android native verification

[Service]
Type=oneshot
WorkingDirectory=%h/papercupai-workspace/papercup-rust-mobile
EnvironmentFile=-%h/.config/papercusp/android-ci.env
ExecStart=/usr/bin/python3 %h/papercupai-workspace/papercup-rust-mobile/tools/android-ci.py
TimeoutStartSec=3h
KillMode=control-group
UMask=0077
